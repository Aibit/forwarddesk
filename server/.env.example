# ForwardDesk WhatsApp service — copy to .env and fill in. Never commit .env.
PORT=8080

# meta = WhatsApp Cloud API directly; 360dialog = same API through 360dialog; mock = local development (sends nothing)
WA_PROVIDER=meta
# Meta: access token (temporary 24 h token while testing; a System User token for production).
# 360dialog: your D360 API key.
WA_TOKEN=
# Meta only: "Phone number ID" from WhatsApp > API Setup (not the phone number itself)
WA_PHONE_NUMBER_ID=
# Meta: App secret (App settings > Basic). 360dialog: platform secret if you have one (optional).
WA_APP_SECRET=
# Any long random string; paste the same value into Meta's webhook settings.
WA_VERIFY_TOKEN=
# Graph API version for Meta
WA_GRAPH_VERSION=v26.0

# Key the ForwardDesk app uses to call /api/wa/* (long random string; enter it once in ForwardDesk > Account/Settings > WhatsApp inbox)
WA_API_KEY=
# Browser origins allowed to call the API
WA_CORS_ORIGINS=https://aibit.github.io

# Storage
WA_DB_PATH=/data/wa.sqlite
WA_MEDIA_DIR=/data/media
WA_MAX_MEDIA_MB=100
# Job references to auto-link, e.g. FD-E-1042
WA_JOB_REF_REGEX=\b[A-Z]{2,4}-[EI]-\d{3,6}\b
# 360dialog without a platform secret: set the same value as a custom webhook header "x-fd-webhook-token"
WA_WEBHOOK_HEADER_TOKEN=
