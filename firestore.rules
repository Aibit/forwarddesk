rules_version = '2';

// ForwardDesk — Firestore security rules (prototype).
//
// DATA MODEL (all business data lives under one org document)
//   userOrgs/{uid}                       { orgId }                       -> which org a signed-in user belongs to
//   orgs/{orgId}                         { name, ownerUid, company }     -> the forwarder company
//   orgs/{orgId}/members/{uid}           { role: 'staff'|'client', clientId?, email }
//   orgs/{orgId}/clients/{cid}           full client record incl. margin — STAFF ONLY
//   orgs/{orgId}/clientPublic/{cid}      { name, contact, lang }         -> what the client may see about itself
//   orgs/{orgId}/lanes/{laneId}          lane profile, { clientId, source: 'desk'|'portal', ... }
//   orgs/{orgId}/agentPrefs/{cid}        { agents: [...] }               -> client's preferred agents
//   orgs/{orgId}/agents/{agentId}        agent directory: name, type, coverage, public contact, hidden flag
//                                        (read: any member — clients pick preferred agents; write: staff; no CRM fields)
//   orgs/{orgId}/agentCrm/{agentId}      agent CRM: status, contacts, payment terms, credit, rating, KYC, notes, tags — STAFF ONLY
//   orgs/{orgId}/agentActivities/{aid}   CRM timeline { agentId, kind, at, text, by } — STAFF ONLY
//   orgs/{orgId}/jobs/{jobId}            { clientId, ..., portal: { draftBlApprovedAt, by } }   (no rebate / margin fields)
//   orgs/{orgId}/jobInternal/{jobId}     { rebateReceived }               -> line rebate status — STAFF ONLY
//   orgs/{orgId}/quotes/{qid}            sell-side quote only { clientId, options[{carrier, sell, transit}], status, ... }
//   orgs/{orgId}/quotes/{qid}/private/costs   buy rates + margins — STAFF ONLY
//   orgs/{orgId}/msds/{msdsId}           { clientId, name, type, size, dataB64 (< 900 KB), uid }
//   orgs/{orgId}/settings/{key}          tariffs (customer-facing fees), msdsRules (read: members, write: staff)
//                                        tariffsPrivate (line rebate %) — STAFF ONLY
//
// Roles are never self-assigned: members/{uid} is written by staff only, except the one-time
// bootstrap where the creator of an org (ownerUid == auth.uid) adds themself as staff.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function memberPath(orgId) { return /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid); }
    function isMember(orgId) { return signedIn() && exists(memberPath(orgId)); }
    function member(orgId) { return get(memberPath(orgId)).data; }
    function isStaff(orgId) { return isMember(orgId) && member(orgId).role == 'staff'; }
    function isClient(orgId) { return isMember(orgId) && member(orgId).role == 'client'; }
    function isClientOf(orgId, cid) { return isClient(orgId) && member(orgId).clientId == cid; }
    function isOwner(orgId) {
      return signedIn() && get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid;
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(m, k, max) { return !(k in m) || m[k] == null || str(m[k], max); }
    function unchanged(k) { return request.resource.data[k] == resource.data[k]; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- validators ----------
    function validMember(d) {
      return d.keys().hasOnly(['role', 'clientId', 'email', 'createdAt'])
        && d.role in ['staff', 'client']
        && (d.role == 'staff' || str(d.clientId, 64))
        && optStr(d, 'clientId', 64) && optStr(d, 'email', 200);
    }
    function validOrg(d) {
      return d.keys().hasOnly(['name', 'ownerUid', 'company', 'createdAt', 'demo'])
        && str(d.name, 120) && d.ownerUid is string
        && (!('company' in d) || d.company is map);
    }
    // Lane written by a client from the portal. Every field typed and size-capped.
    function validVolume(v) {
      return v is map && v.keys().hasOnly(['amount', 'unit', 'period'])
        && (v.amount == null || v.amount is number) && str(v.unit, 20) && str(v.period, 20);
    }
    function validTarget(t) {
      return t is map && t.keys().hasOnly(['amount', 'currency', 'per'])
        && (t.amount == null || t.amount is number) && str(t.currency, 8) && str(t.per, 20);
    }
    function validMsdsMeta(m) {
      return m == null || (m is map && m.keys().hasOnly(['id', 'name', 'size', 'type', 'at'])
        && str(m.id, 80) && str(m.name, 200) && m.size is number && str(m.type, 100) && m.at is number);
    }
    function validLane(d) {
      return d.keys().hasOnly(['id', 'clientId', 'source', 'pol', 'pod', 'commodity', 'hs', 'volume', 'payment',
                               'target', 'notes', 'dg', 'msds', 'submittedAt', 'updatedAt'])
        && str(d.id, 80) && str(d.clientId, 64) && d.source in ['desk', 'portal']
        && str(d.pol, 80) && str(d.pod, 80) && str(d.commodity, 200) && str(d.hs, 20)
        && validVolume(d.volume) && str(d.payment, 40) && validTarget(d.target)
        && str(d.notes, 2000) && (!('dg' in d) || d.dg is bool)
        && (!('msds' in d) || validMsdsMeta(d.msds))
        && (!('submittedAt' in d) || d.submittedAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }
    function validPrefs(d, cid) {
      return d.keys().hasOnly(['clientId', 'agents', 'updatedAt'])
        && d.clientId == cid && d.agents is list && d.agents.size() <= 50 && d.updatedAt is number;
    }
    // Agent directory doc: only directory fields; CRM fields (contacts, credit, notes...) are refused here.
    function validAgentPub(d) {
      return d.keys().hasOnly(['id', 'name', 'type', 'country', 'city', 'ports', 'lanes', 'services', 'portal', 'website',
                               'email', 'phone', 'whatsapp', 'sanctions', 'source', 'sample', 'publicInfo', 'svc', 'lanePairs',
                               'networks', 'hidden', 'updatedAt'])
        && str(d.name, 200) && d.name.size() > 0
        && (!('type' in d) || d.type in ['overseas', 'line', 'forwarder', 'trucker', 'clearance', 'network', 'other'])
        && optStr(d, 'ports', 2000) && optStr(d, 'lanes', 4000) && optStr(d, 'services', 2000) && optStr(d, 'portal', 4000)
        && optStr(d, 'sanctions', 4000) && optStr(d, 'source', 4000)
        && (!('svc' in d) || (d.svc is list && d.svc.size() <= 5))
        && (!('lanePairs' in d) || (d.lanePairs is list && d.lanePairs.size() <= 60))
        && (!('networks' in d) || (d.networks is list && d.networks.size() <= 30))
        && (!('hidden' in d) || d.hidden is bool);
    }
    function validAgentCrm(d) {
      return d.keys().hasOnly(['status', 'contacts', 'paymentTerms', 'creditLimit', 'currency', 'rating', 'tags', 'kyc',
                               'archived', 'notes', 'createdAt', 'updatedAt'])
        && (!('status' in d) || d.status in ['prospect', 'active', 'preferred', 'on_hold', 'blacklisted'])
        && (!('contacts' in d) || (d.contacts is list && d.contacts.size() <= 40))
        && optStr(d, 'paymentTerms', 300) && optStr(d, 'currency', 8) && optStr(d, 'notes', 10000)
        && (!('creditLimit' in d) || d.creditLimit == null || (d.creditLimit is number && d.creditLimit >= 0))
        && (!('rating' in d) || (d.rating is number && d.rating >= 0 && d.rating <= 5))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 40))
        && (!('kyc' in d) || (d.kyc is list && d.kyc.size() <= 12))
        && (!('archived' in d) || d.archived is bool);
    }
    function validActivity(d) {
      return d.keys().hasOnly(['agentId', 'kind', 'at', 'text', 'by'])
        && str(d.agentId, 80) && d.kind in ['note', 'call', 'email', 'meeting', 'rate_request', 'rate_reply']
        && d.at is number && str(d.text, 4000) && d.by == request.auth.uid;
    }
    function validMsdsDoc(d) {
      return d.keys().hasOnly(['clientId', 'name', 'type', 'size', 'dataB64', 'uid', 'at'])
        && str(d.clientId, 64) && str(d.name, 200) && str(d.type, 100)
        && d.size is number && d.size <= 650000
        && str(d.dataB64, 900000) && d.uid == request.auth.uid && d.at == request.time;
    }

    // ---------- top-level ----------
    match /userOrgs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Staff of the target org (or the org owner during bootstrap) link a user to the org.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orgId'])
        && str(request.resource.data.orgId, 64)
        && (isStaff(request.resource.data.orgId) || (uid == request.auth.uid && isOwner(request.resource.data.orgId)));
      // Moving a user between orgs needs staff rights in BOTH orgs.
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['orgId'])
        && str(request.resource.data.orgId, 64)
        && isStaff(resource.data.orgId) && isStaff(request.resource.data.orgId);
      allow delete: if signedIn() && isStaff(resource.data.orgId);
    }

    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      // Bootstrap: only the 'demo' org can be created, once, and the creator becomes owner.
      allow create: if signedIn() && orgId == 'demo'
        && validOrg(request.resource.data) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isStaff(orgId) && validOrg(request.resource.data) && unchanged('ownerUid');
      allow delete: if false;

      match /members/{uid} {
        allow read: if isStaff(orgId) || (signedIn() && request.auth.uid == uid);
        allow create: if validMember(request.resource.data)
          && (isStaff(orgId) || (uid == request.auth.uid && isOwner(orgId) && request.resource.data.role == 'staff'));
        allow update: if isStaff(orgId) && validMember(request.resource.data);
        allow delete: if isStaff(orgId) && uid != request.auth.uid;
      }

      // Staff-only: full client record (margin %, internal notes).
      match /clients/{cid} {
        allow read, write: if isStaff(orgId);
      }
      match /clientPublic/{cid} {
        allow read: if isStaff(orgId) || isClientOf(orgId, cid);
        allow write: if isStaff(orgId);
      }

      match /lanes/{laneId} {
        allow read: if isStaff(orgId) || isClientOf(orgId, resource.data.clientId);
        allow create: if isStaff(orgId)
          || (isClientOf(orgId, request.resource.data.clientId)
              && request.resource.data.source == 'portal'
              && request.resource.data.id == laneId
              && validLane(request.resource.data));
        allow update: if isStaff(orgId)
          || (isClientOf(orgId, resource.data.clientId)
              && validLane(request.resource.data)
              && unchanged('clientId') && unchanged('source') && unchanged('id')
              // portal lanes: client may edit; desk lanes: client may only attach / replace the MSDS
              && (resource.data.source == 'portal' || changedOnly(['msds', 'updatedAt'])));
        allow delete: if isStaff(orgId)
          || (isClientOf(orgId, resource.data.clientId) && resource.data.source == 'portal');
      }

      match /agentPrefs/{cid} {
        allow read: if isStaff(orgId) || isClientOf(orgId, cid);
        allow write: if isStaff(orgId)
          || (isClientOf(orgId, cid) && validPrefs(request.resource.data, cid));
      }

      match /agents/{agentId} {
        allow read: if isMember(orgId);
        allow create, update: if isStaff(orgId) && validAgentPub(request.resource.data);
        allow delete: if isStaff(orgId);
      }
      match /agentCrm/{agentId} {
        allow read, delete: if isStaff(orgId);
        allow create, update: if isStaff(orgId) && validAgentCrm(request.resource.data);
      }
      match /agentActivities/{aid} {
        allow read, delete: if isStaff(orgId);
        allow create, update: if isStaff(orgId) && validActivity(request.resource.data);
      }

      match /jobs/{jobId} {
        allow read: if isStaff(orgId) || isClientOf(orgId, resource.data.clientId);
        allow create, delete: if isStaff(orgId);
        // Client may only stamp the draft B/L approval.
        allow update: if isStaff(orgId)
          || (isClientOf(orgId, resource.data.clientId)
              && changedOnly(['portal'])
              && request.resource.data.portal is map
              && request.resource.data.portal.keys().hasOnly(['draftBlApprovedAt', 'by'])
              && request.resource.data.portal.draftBlApprovedAt == request.time
              && request.resource.data.portal.by == request.auth.uid);
      }

      match /jobInternal/{jobId} {
        allow read, write: if isStaff(orgId);
      }

      match /quotes/{qid} {
        allow read: if isStaff(orgId) || isClientOf(orgId, resource.data.clientId);
        allow create, delete: if isStaff(orgId);
        // Client may only accept a sent quote, naming one option.
        allow update: if isStaff(orgId)
          || (isClientOf(orgId, resource.data.clientId)
              && resource.data.status == 'sent'
              && changedOnly(['status', 'acceptedOption', 'acceptedVia', 'acceptedAt', 'acceptedBy'])
              && request.resource.data.status == 'won'
              && request.resource.data.acceptedVia == 'portal'
              && str(request.resource.data.acceptedOption, 120)
              && request.resource.data.acceptedAt == request.time
              && request.resource.data.acceptedBy == request.auth.uid);

        // Buy rates and margins — never readable by clients.
        match /private/{doc} {
          allow read, write: if isStaff(orgId);
        }
      }

      match /msds/{msdsId} {
        allow read: if isStaff(orgId) || isClientOf(orgId, resource.data.clientId);
        allow create: if (isStaff(orgId) || isClientOf(orgId, request.resource.data.clientId))
          && validMsdsDoc(request.resource.data);
        allow update: if false;
        allow delete: if isStaff(orgId)
          || (isClientOf(orgId, resource.data.clientId) && resource.data.uid == request.auth.uid);
      }

      match /settings/{key} {
        allow read: if isStaff(orgId) || (isMember(orgId) && key in ['tariffs', 'msdsRules']);
        allow write: if isStaff(orgId) && key in ['tariffs', 'tariffsPrivate', 'msdsRules'];
      }
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
